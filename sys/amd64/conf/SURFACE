#
# SURFACE -- Kernel configuration file for Microsoft Surface hardware
#
# This is GENERIC plus the Surface Serial Hub (SAM/SSAM) transport.
# surface_sam attaches to the MSHW0084 ACPI serial device and creates the
# clients behind it: surface_hid (internal keyboard and touchpad),
# surface_profile (performance profile), surface_mon (temperature sensors
# and fan) and surface_rtc (the clock of the EC).
#
# The input side of the HID clients is already part of GENERIC: evdev,
# hidbus, hconf and hmt.  hmt requires hconf, so both are needed for the
# touchpad to work.
#
# For more information on this file, please read the config(5) manual page,
# and/or the handbook section on Kernel Configuration Files:
#
#    https://docs.freebsd.org/en/books/handbook/kernelconfig/#kernelconfig-config
#
# The handbook is also available locally in /usr/share/doc/handbook
# if you've installed the doc distribution, otherwise always see the
# FreeBSD World Wide Web server (https://www.FreeBSD.org/) for the
# latest information.
#
# An exhaustive list of options and more detailed explanations of the
# device lines is also present in the ../../conf/NOTES and NOTES files.
# If you are in doubt as to the purpose or necessity of a line, check first
# in NOTES.
#

#NO_UNIVERSE

include		GENERIC

ident		SURFACE

# Surface Serial Hub (SAM) transport and its HID, monitoring, performance
# profile and clock clients.
device		surface_sam		# Surface Aggregator Module (MSHW0084)
